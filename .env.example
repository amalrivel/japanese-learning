# Salin ke .env.local untuk development dengan emulator, bukan untuk production.
NEXT_PUBLIC_USE_FIREBASE_EMULATORS=true
NEXT_PUBLIC_FIREBASE_API_KEY=fake-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-learning-pwa.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-learning-pwa
NEXT_PUBLIC_FIREBASE_APP_ID=demo-app-id
FIREBASE_PROJECT_ID=demo-learning-pwa
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# Ganti dengan UID akun fiktif dari Emulator UI setelah akun dibuat.
APP_ALLOWED_UIDS=local-learner
